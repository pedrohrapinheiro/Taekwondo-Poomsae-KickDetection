import cv2 as cv
import numpy as np
import tensorflow as tf
from ultralytics import YOLO
from collections import deque
import joblib
import os

# Silenciar avisos do TensorFlow e sklearn para limpar o terminal
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'
import warnings
warnings.filterwarnings("ignore", category=UserWarning)

# ==========================================
# 0. GEOMETRY UTILS
# ==========================================
def calculate_angle(a, b, c):
    """Calcula o ângulo em graus entre três pontos (a, b, c) onde b é o vértice."""
    a = np.array(a)
    b = np.array(b)
    c = np.array(c)

    radians = np.arctan2(c[1] - b[1], c[0] - b[0]) - np.arctan2(a[1] - b[1], a[0] - b[0])
    angle = np.abs(radians * 180.0 / np.pi)

    if angle > 180.0:
        angle = 360 - angle

    return angle

# ==========================================
# 1. LOAD MODELS AND ASSETS
# ==========================================
print("Loading models... please wait.")
pose_model = YOLO("yolov8n-pose.pt")
# O novo modelo foi treinado com features geométricas
kick_model = tf.keras.models.load_model('model\\kick_detection_model.h5')
scaler = joblib.load('model\\scaler.pkl')

# Voting Buffer: Stores the last 15 frames of predictions
prediction_buffer = deque(maxlen=15)
prev_keypoints = None

# Performance optimizations
FRAME_SKIP = 5
frame_count = 0

cap = cv.VideoCapture(0)

# ULTRA LOW RESOLUTION: Essential for CPU real-time performance
cap.set(cv.CAP_PROP_FRAME_WIDTH, 320)
cap.set(cv.CAP_PROP_FRAME_HEIGHT, 240)

print("System Ready! Press 'q' to quit.")

while True:
      ret, frame = cap.read()
      if not ret:
          break

      frame_count += 1

      # ==========================================
      # 2. POSE EXTRACTION (YOLO)
      # ==========================================
      results = pose_model(frame, verbose=False)

      if results[0].keypoints is None or len(results[0].keypoints.xy) == 0:
          prediction_buffer.append(0)
          text = "NO PERSON DETECTED"
          color = (255, 255, 255)
          cv.putText(frame, f"Status: {text}", (20, 40), cv.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
          cv.imshow('Taekwondo Kick Detection - Realtime', frame)
          if cv.waitKey(1) & 0xFF == ord('q'): break
          continue

      xy = results[0].keypoints.xy[0].cpu().numpy()
      conf = results[0].keypoints.conf[0].cpu().numpy()

      # SAFETY LOCK 1: Leg Visibility
      leg_indices = [11, 12, 13, 14, 15, 16]
      leg_confidences = [conf[i] if i < len(conf) else 0 for i in leg_indices]
      legs_visible = any(c > 0.5 for c in leg_confidences)

      current_kp = []
      for i in range(17):
          if i < len(xy):
                current_kp.append([xy[i][0], xy[i][1], conf[i]])
          else:
                current_kp.append([0, 0, 0])

      # ==========================================
      # 3. GEOMETRIC FEATURE EXTRACTION (Sincronizado com Treino)
      # ==========================================
      if frame_count % FRAME_SKIP == 0:
          if not legs_visible:
              label = 0
          else:
              try:
                  # Centro do quadril como referência (kp11, kp12)
                  hip_center = np.array([
                      (current_kp[11][0] + current_kp[12][0]) / 2,
                      (current_kp[11][1] + current_kp[12][1]) / 2
                  ])

                  # 1. Coordenadas Relativas
                  relative_coords = []
                  for i in range(17):
                      px = current_kp[i][0] - hip_center[0]
                      py = current_kp[i][1] - hip_center[1]
                      relative_coords.extend([px, py])

                  # 2. Ângulos Geométricos
                  # Joelho Esquerdo (11 -> 13 -> 15)
                  angle_knee_l = calculate_angle(
                      [current_kp[11][0], current_kp[11][1]],
                      [current_kp[13][0], current_kp[13][1]],
                      [current_kp[15][0], current_kp[15][1]]
                  )
                  # Joelho Direito (12 -> 14 -> 16)
                  angle_knee_r = calculate_angle(
                      [current_kp[12][0], current_kp[12][1]],
                      [current_kp[14][0], current_kp[14][1]],
                      [current_kp[16][0], current_kp[16][1]]
                  )
                  # Quadril Esquerdo (Ombro 5 -> Quadril 11 -> Joelho 13)
                  angle_hip_l = calculate_angle(
                      [current_kp[5][0], current_kp[5][1]],
                      [current_kp[11][0], current_kp[11][1]],
                      [current_kp[13][0], current_kp[13][1]]
                  )
                  # Quadril Direito (Ombro 6 -> Quadril 12 -> Joelho 14)
                  angle_hip_r = calculate_angle(
                      [current_kp[6][0], current_kp[6][1]],
                      [current_kp[12][0], current_kp[12][1]],
                      [current_kp[14][0], current_kp[14][1]]
                  )

                  # 3. Distâncias Normalizadas
                  dist_foot_l = np.linalg.norm(np.array([current_kp[15][0], current_kp[15][1]]) - hip_center)
                  dist_foot_r = np.linalg.norm(np.array([current_kp[16][0], current_kp[16][1]]) - hip_center)

                  # Montar vetor de features idêntico ao dataset_geometric.csv
                  features = relative_coords + [angle_knee_l, angle_knee_r, angle_hip_l, angle_hip_r, dist_foot_l, dist_foot_r]
                  combined_features = np.array(features).reshape(1, -1)

                  # Normalização e Predição
                  scaled_features = scaler.transform(combined_features)
                  prediction_prob = kick_model(scaled_features, training=False).numpy()[0][0]
                  label = 1 if prediction_prob > 0.5 else 0

              except Exception as e:
                  print(f"Erro no processamento geométrico: {e}")
                  label = 0

          prediction_buffer.append(label)
      else:
          if len(prediction_buffer) > 0:
              prediction_buffer.append(prediction_buffer[-1])

      # ==========================================
      # 4. VOTING LOGIC & DISPLAY
      # ==========================================
      if len(prediction_buffer) > 0:
          vote_score = sum(prediction_buffer) / len(prediction_buffer)

          if vote_score > 0.7:
              text = "KICKING!"
              color = (0, 255, 0)
          else:
              text = "NO KICK"
              color = (0, 0, 255)
      else:
          text = "Analyzing..."
          color = (255, 255, 255)

      cv.putText(frame, f"Status: {text}", (20, 40), cv.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)

      cv.imshow('Taekwondo Kick Detection - Realtime', frame)

      if cv.waitKey(1) & 0xFF == ord('q'):
          break

cap.release()
cv.destroyAllWindows()
